# ─── Backend API ──────────────────────────────────────────
# Development requests use this same-origin path through the Vite proxy.
VITE_API_URL=/api
VITE_DEV_API_PROXY_TARGET=https://fac.firstadvantageconsulting.com:9001

# ─── Optional: Request Timeout (milliseconds) ────────────
VITE_API_TIMEOUT=30000

# ─── Optional: App Configuration ─────────────────────────
VITE_APP_NAME=GRC Platform
